{
    "name": "echo-fusion/middlewaremanager",
    "description": "a middleware manager implements PSR-15 and PSR-7",
    "keywords": [
        "middleware manager",
        "psr-15",
        "psr-7"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/echo-fusion/middlewaremanager",
    "authors": [
        {
            "name": "Amir Shadanfar",
            "email": "a.shadanfar.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/echo-fusion/middlewaremanager/issues",
        "source": "https://github.com/echo-fusion/middlewaremanager"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "psr/container": "^2.0",
        "echo-fusion/contracts": "^1.1",
        "psr/http-message": "^2.0",
        "guzzlehttp/psr7": "^2.5",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^5.26",
        "friendsofphp/php-cs-fixer": "^3.64",
        "echo-fusion/codestandard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "EchoFusion\\MiddlewareManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EchoFusion\\MiddlewareManager\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": [
            "@cs-check",
            "@analyze",
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit",
        "test:coverage:text": "vendor/bin/phpunit --coverage-text",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "analyze": "psalm --show-info=false --no-cache --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
